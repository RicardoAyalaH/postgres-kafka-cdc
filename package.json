{
  "name": "postgres-kafka-cdc",
  "version": "0.1.0",
  "private": true,
  "description": "Learning project: Postgres change-data-capture pipeline with Debezium, Kafka and a TypeScript consumer.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "generate": "node --env-file=.env src/generator/index.ts",
    "typecheck": "tsc",
    "slot-monitor": "node --env-file=.env src/slot-monitor/index.ts",
    "test": "vitest run --exclude \"**/*.db.test.ts\"",
    "test:db": "vitest run src/consumer/mapping.db.test.ts"
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "^1.11.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "@confluentinc/kafka-javascript@1.11.0": true
  }
}
