{
  // Node 24 runs .ts files directly by stripping types; tsc is used only for type checking.
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,

    // Required for Node's type stripping: only syntax that can be erased (no enums,
    // no parameter properties), explicit `import type`, and `.ts` import paths.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,

    "skipLibCheck": true
  },
  "include": ["src"]
}
