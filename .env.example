# Copy this file to .env and adjust values. .env is git-ignored.
# These are local-only development credentials; never reuse real passwords here.

# Source database (the one Debezium captures changes from)
SOURCE_POSTGRES_USER=cdc_source
SOURCE_POSTGRES_PASSWORD=change-me
SOURCE_POSTGRES_DB=shop
# How scripts on the host reach it (docker-compose maps container 5432 -> host 5433)
SOURCE_POSTGRES_HOST=localhost
SOURCE_POSTGRES_PORT=5433

# Least-privilege role Debezium uses to read the source WAL (LOGIN + REPLICATION, SELECT only)
DEBEZIUM_POSTGRES_USER=debezium
DEBEZIUM_POSTGRES_PASSWORD=change-me

# Read-only role the slot monitor uses (member of pg_monitor; no table access)
MONITOR_POSTGRES_USER=cdc_monitor
MONITOR_POSTGRES_PASSWORD=change-me

# Destination database (where the consumer applies changes)
DEST_POSTGRES_USER=cdc_dest
DEST_POSTGRES_PASSWORD=change-me
DEST_POSTGRES_DB=shop_replica
# How the consumer and DB tests on the host reach it (container 5432 -> host 5434)
DEST_POSTGRES_HOST=localhost
DEST_POSTGRES_PORT=5434

# Least-privilege role the consumer uses on dest-db (SELECT/INSERT/UPDATE on orders; no DELETE)
CONSUMER_POSTGRES_USER=cdc_consumer
CONSUMER_POSTGRES_PASSWORD=change-me
