# Copy this file to .env and adjust values. .env is git-ignored.
# These are local-only development credentials; never reuse real passwords here.

# Source database (the one Debezium captures changes from)
SOURCE_POSTGRES_USER=cdc_source
SOURCE_POSTGRES_PASSWORD=change-me
SOURCE_POSTGRES_DB=shop

# Destination database (where the consumer applies changes)
DEST_POSTGRES_USER=cdc_dest
DEST_POSTGRES_PASSWORD=change-me
DEST_POSTGRES_DB=shop_replica
